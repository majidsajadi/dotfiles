[user]
	# Identify commits created on this machine.
	name = majidsajadi
	email = majidsajadi93@gmail.com

[init]
	# Start new repositories on the main branch.
	defaultBranch = main

[push]
	# Set the upstream branch during the first push.
	autoSetupRemote = true

[fetch]
	# Remove references to deleted remote branches.
	prune = true

[merge]
	# Include the common ancestor in conflict markers.
	conflictStyle = zdiff3

[url "https://github.com/"]
	# Expand gh: paths to GitHub HTTPS URLs.
	insteadOf = gh: